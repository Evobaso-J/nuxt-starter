{
  "name": "nuxt-starter-4",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npx nuxt typecheck",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:server": "vitest --project server",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.0",
    "@nuxtjs/i18n": "10.6.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "engines": {
    "node": ">=23.6.0",
    "pnpm": ">=11.0.0"
  },
  "engineStrict": true,
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "playwright-core": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
